<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >

<mapper namespace="com.yvqing.loginregister.dao.LoReDao">
    <insert id="addUserByPhone" parameterType="com.yuqing.user.bean.User"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO user (account, telephone, password, create_time)
        VALUES (#{account}, #{telephone}, #{password}, #{create_time})
    </insert>
    <insert id="addUserByEmail" parameterType="com.yuqing.user.bean.User"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO user (account, email, password, create_time)
        VALUES (#{account}, #{email}, #{password}, #{create_time})
    </insert>

    <!--    写要执行的sql语句-->
    <select id="findALL" resultType="com.yuqing.user.bean.User">
        select *
        from user
    </select>
    <select id="getUserByAccount" resultType="com.yuqing.user.bean.User">
        SELECT *
        FROM user
        WHERE account = #{account}
    </select>
    <select id="getUserByPhone" resultType="com.yuqing.user.bean.User">
        SELECT *
        FROM user
        WHERE telephone = #{telephone}
    </select>
    <select id="getUserByEmail" resultType="com.yuqing.user.bean.User">
        SELECT *
        FROM user
        WHERE email = #{email}
    </select>
    <select id="findUserByPhone" resultType="java.lang.Integer">
        SELECT COUNT(*)
        FROM user
        WHERE telephone = #{telephone}
    </select>
    <select id="findUserByEmail" resultType="java.lang.Integer">
        SELECT COUNT(*)
        FROM user
        WHERE email = #{email}
    </select>

</mapper>
